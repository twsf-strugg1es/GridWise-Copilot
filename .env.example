# Copy to .env and fill in. NEVER commit .env -- it is gitignored.

# ---------------------------------------------------------------------------
# Language model (REQUIRED -- operator-note interpretation runs through it)
# ---------------------------------------------------------------------------

# API key for an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=

# Leave blank for OpenAI. Set it to use any OpenAI-compatible provider, e.g.
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (Ollama, local model)
LLM_BASE_URL=

# Model identifier as the provider names it.
LLM_MODEL=gpt-4o-mini

# Per-call timeout in seconds. Kept well under the judge's 30s request budget so
# a slow provider fails over to the fallback instead of timing out the request.
LLM_TIMEOUT_SECONDS=20

# Attempts at the model per request. Attempt 2 is a repair attempt that is given
# the guardrail's own rejection message.
LLM_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------

# 1 = if the model is unreachable, answer from the heuristic fallback instead of
# erroring. 0 = surface the failure. The LLM remains the primary interpreter
# either way; see backend/llm/fallback.py for why this exists.
ALLOW_HEURISTIC_FALLBACK=1

LOG_LEVEL=INFO
PORT=8000
